static void MX_GPIO_Init(void);
void StartDefaultTask(void *argument);

void HandlerTask(void *pvParameters);

QueueHandle_t Uart2_ByteRecieve;

int main(void)
{

  HAL_Init();
  /* Configure the system clock */
  SystemClock_Config();
  /* Initialize all configured peripherals */
  MX_GPIO_Init();


  xTaskCreate(HandlerTask,
		      "Handle Uart_rx",
			  100,
			  NULL,
			  taskIDLE_PRIORITY + 3,
			  NULL);

  Uart2_ByteRecieve = xQueueCreate(10, sizeof(char));

  vTaskStartScheduler();

  while (1)
  {
  }
}


void Start_rx_interrupt(void)
{

	/*Interrupt Enable*/
	USART2->CR1 |= (1U<<5);

	NVIC_SetPriority(USART2_IRQn,6);

	/*Enable UART2 interrupt in NVIC*/
	NVIC_EnableIRQ(USART2_IRQn);
}

void USART2_IRQHandler(void)
{
	BaseType_t pxHigherPriorityTaskWoken = pdFALSE;

	if (USART2->SR & 0x0020)
	{
		uint8_t temp_data;
		temp_data = USART2->DR;

		xQueueSendFromISR(Uart2_ByteRecieve, &temp_data, &pxHigherPriorityTaskWoken);

	}


	portYIELD_FROM_ISR(pxHigherPriorityTaskWoken);

}

char buffer;
void HandlerTask(void *pvParameters)
{
	MX_USART2_UART_RX_Init();
	Start_rx_interrupt();

	while(1)
	{
		xQueueReceive(Uart2_ByteRecieve,&buffer, portMAX_DELAY);
	}
}

